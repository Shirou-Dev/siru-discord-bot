# ── Discord ──────────────────────────────────────────────────────────────
DISCORD_TOKEN="your-bot-token"
DISCORD_CLIENT_ID="your-application-id"
GUILD_ID="your-discord-server-id"

# Channel ที่โชว์ Dashboard สถานะ (A) — สาธารณะ ทุกคนเห็นได้
ALERT_CHANNEL_ID="123456789012345678"
# Channel ประกาศ event (activation/IP change/ใกล้หมดอายุ) — เห็นเฉพาะแอดมิน
# ตั้งสิทธิ์ใน Discord: ปิด View Channel ของ @everyone แล้วเปิดให้ ADMIN_ROLE_ID
# ถ้าเว้นว่าง จะส่งรวมไปที่ ALERT_CHANNEL_ID เหมือนเดิม
EVENT_CHANNEL_ID="123456789012345678"
# Channel ที่แอดมินรีวิวใบสมัคร sponsor (D)
SPONSOR_REVIEW_CHANNEL_ID="123456789012345678"
# Channel ที่ประกาศ sponsor ที่อนุมัติแล้ว (D) — เว้นว่างได้
SPONSOR_ANNOUNCE_CHANNEL_ID=""

# Role ที่ให้เมื่ออนุมัติ sponsor (D)
SPONSOR_ROLE_ID="123456789012345678"
# Role ของแอดมินที่กดอนุมัติ/ปฏิเสธได้ (D)
ADMIN_ROLE_ID="123456789012345678"

# ── Database (ตัวเดียวกับ backend SIRU-SKIN) ───────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/skinsystem"

# ── Service Status panel (เลียนแบบ siruskin-status page) ───────────────────
# เปิด/ปิด panel นี้
SERVICE_PANEL_ENABLED=true
# ช่องที่โชว์ panel (เว้นว่าง = ใช้ ALERT_CHANNEL_ID)
SERVICE_CHANNEL_ID=""
# endpoint ดึงสถานะ — ใช้ localhost บน VPS เพื่อเลี่ยง Cloudflare
SERVICE_HEALTH_URL="http://localhost:3000/health"
SERVICE_PM2_URL="http://localhost:3009/api/pm2"
SERVICE_INCIDENTS_URL="http://localhost:3009/api/incidents"

# ── Figura Status panel & Topup (SIRU-FiguraCloud — Rust, port 3011) ────────
FIGURA_PANEL_ENABLED=true
FIGURA_CHANNEL_ID=""
FIGURA_STATS_URL="http://localhost:3011/api/stats"
FIGURA_VERSION_URL="http://localhost:3011/api/version"
FIGURA_MOTD_URL="http://localhost:3011/api/motd"
FIGURA_API_URL="http://localhost:3011"
FIGURA_ROLE_ID=""
TOPUP_NOTICE_CHANNEL_ID="1548613195051307099"
FIGURA_SERVER_PRICE=50

# ── SIRU-Network · Node Status panel (Cluster / Failover) ───────────────────
CLUSTER_PANEL_ENABLED=true
# ช่องที่โชว์ Node Status panel (เว้นว่าง = ใช้ช่องเดียวกับ FIGURA/SERVICE)
CLUSTER_CHANNEL_ID=""


# ── Monitoring thresholds (A) — หน่วยเป็นนาที/วัน ──────────────────────────
# heartbeat เงียบเกินกี่นาที = ถือว่า offline
OFFLINE_AFTER_MINUTES=6
# เตือนใกล้หมดอายุที่กี่วันก่อนหมด (คั่นด้วย comma)
EXPIRY_WARN_DAYS="3,1"
# รอบการสแกน monitoring (cron) — ดีฟอลต์ทุก 1 นาที
MONITOR_CRON="*/1 * * * *"

# ── Sponsor eligibility (D) — เงื่อนไขที่ bot ตรวจก่อนส่งให้แอดมินอนุมัติ ──
# ต้องอยู่ใน Discord มาแล้วกี่วัน
SPONSOR_MIN_MEMBER_DAYS=7
# server ต้องเปิดมาแล้วกี่วัน (createdAt)
SPONSOR_MIN_SERVER_AGE_DAYS=7
# ต้องมีผู้เล่นออนไลน์อย่างน้อยกี่คนตอนสมัคร
SPONSOR_MIN_ONLINE_PLAYERS=3
# Role ที่ผู้สมัครต้องมี (เช่น Partner) — เว้นว่าง = ไม่บังคับ
SPONSOR_REQUIRED_ROLE_ID=""
# จำนวนวันที่ขยาย expiresAt ให้เมื่ออนุมัติ sponsor
SPONSOR_GRANT_DAYS=90
