{
  "name": "siru-skin-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for SIRU-SKIN — server monitoring/alerts (A) + sponsor verification (D). Standalone, reads the same Postgres as the backend; does not modify backend files.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "deploy-commands": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5"
  }
}
